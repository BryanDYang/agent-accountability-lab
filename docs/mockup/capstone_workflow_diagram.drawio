        <mxCell id="vuJTIm96bQAWBJX1B6yz-437" parent="vuJTIm96bQAWBJX1B6yz-478" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;p&gt;For intra-tier contradictions, a small, fast model (such as a local lightweight SLM or a fast API call or open source model) is executed with strict structured output.&lt;/p&gt;&lt;h4&gt;&lt;/h4&gt;" vertex="1">
