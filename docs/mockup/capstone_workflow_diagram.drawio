        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-516" parent="vuJTIm96bQAWBJX1B6yz-523" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&amp;lt;governed_context&amp;gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;lt;context_node id=&quot;rule_auth_jwt_01&quot; type=&quot;MANDATORY_RULE&quot; source=&quot;.cursorrules&quot;&amp;gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; All authentication endpoints must enforce HttpOnly SameSite=Strict cookies. Do not accept raw Bearer tokens in query parameters.&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;lt;/context_node&amp;gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;lt;context_node id=&quot;doc_oauth_redis&quot; type=&quot;REFERENCE_DOC&quot; source=&quot;docs/architecture/oauth_migration.md&quot;&amp;gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Cache OAuth state in Redis using key format oauth:state:&amp;lt;uuid&amp;gt; with 300s TTL prior to token exchange.&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;lt;/context_node&amp;gt;&lt;/div&gt;&lt;div&gt;&amp;lt;/governed_context&amp;gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="740" x="10" y="47.5" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-526" edge="1" parent="1" source="vuJTIm96bQAWBJX1B6yz-503" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="vuJTIm96bQAWBJX1B6yz-525">
