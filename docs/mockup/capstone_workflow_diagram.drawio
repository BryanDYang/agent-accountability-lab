        <mxCell id="vuJTIm96bQAWBJX1B6yz-383" parent="vuJTIm96bQAWBJX1B6yz-474" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &quot;surviving_candidates&quot;: [&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;id&quot;: &quot;rule_auth_jwt_01&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;source_type&quot;: &quot;repo_rule&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;priority_tier&quot;: 1,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;content&quot;: &quot;All authentication endpoints must enforce HttpOnly SameSite=Strict cookies.&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; },&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;id&quot;: &quot;doc_oauth_spec_v2&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;source_type&quot;: &quot;company_doc&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;priority_tier&quot;: 2,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;content&quot;: &quot;OAuth2 state validation requires caching nonces in Redis with a 300-second TTL prior to token exchange.&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; ],&lt;/div&gt;&lt;div&gt;&amp;nbsp; &quot;pruned_audit&quot;: [&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;id&quot;: &quot;mem_session_948&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;action&quot;: &quot;DROPPED&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;reason&quot;: &quot;OVERRIDDEN_BY_TIER_1 (rule_auth_jwt_01)&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; ]&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="350" width="535.09" x="27.449999999999818" y="80" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-471" parent="vuJTIm96bQAWBJX1B6yz-474" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Output of Hard Deterministic Pruner&lt;/font&gt;" vertex="1">
          <mxGeometry height="39.2" width="355" x="110" y="10" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-508" edge="1" parent="1" source="vuJTIm96bQAWBJX1B6yz-483" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="vuJTIm96bQAWBJX1B6yz-504">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-507" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="400" width="630" x="3290" y="5330" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-504" parent="vuJTIm96bQAWBJX1B6yz-507" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="400" width="630" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-505" parent="vuJTIm96bQAWBJX1B6yz-507" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&amp;lt;governed_context&amp;gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp; &amp;lt;context_node id=&quot;rule_auth_jwt_01&quot; type=&quot;MANDATORY_RULE&quot; source=&quot;.cursorrules&quot;&amp;gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp; &amp;nbsp; All authentication endpoints must enforce HttpOnly SameSite=Strict cookies. Do not accept raw Bearer tokens in query parameters.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp; &amp;lt;/context_node&amp;gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp; &amp;lt;context_node id=&quot;doc_oauth_redis&quot; type=&quot;REFERENCE_DOC&quot; source=&quot;docs/architecture/oauth_migration.md&quot;&amp;gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp; &amp;nbsp; Cache OAuth state in Redis using key format oauth:state:&amp;lt;uuid&amp;gt; with 300s TTL prior to token exchange.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp; &amp;lt;/context_node&amp;gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&amp;lt;/governed_context&amp;gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="570" x="30" y="80" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-506" parent="vuJTIm96bQAWBJX1B6yz-507" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Final Output Contract&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="270" x="180" y="10" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-510" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="1250" width="1090" x="3060" y="3850" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-483" parent="vuJTIm96bQAWBJX1B6yz-510" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="1250" width="1090" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-484" parent="vuJTIm96bQAWBJX1B6yz-510" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;2.3 Context Compiler &amp;amp; Token Budget Packer&lt;/font&gt;" vertex="1">
          <mxGeometry height="39.2" width="375.41" x="357.28999999999996" y="20" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-494" connectable="0" parent="vuJTIm96bQAWBJX1B6yz-510" style="group" value="" vertex="1">
          <mxGeometry height="230" width="476" x="40" y="140" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-485" parent="vuJTIm96bQAWBJX1B6yz-494" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="230" width="476" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-486" parent="vuJTIm96bQAWBJX1B6yz-494" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Exact Token Counting &amp;amp; Cost Attribution&lt;/font&gt;" vertex="1">
          <mxGeometry height="39.2" width="339.46" x="60" y="9" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-487" parent="vuJTIm96bQAWBJX1B6yz-494" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;li style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;Why it matters:&lt;/b&gt; Rough word-count approximations often miss byte-pair encoding (BPE) expansions for source code and regex tokens.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;Mechanism:&lt;/b&gt; The compiler passes each &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;ContextItem.content&lt;/code&gt; through a tokenizer (such as &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;tiktoken&lt;/code&gt; for OpenAI/Claude models or a local fast tokenizer) and tags each object with its exact token weight:&lt;/p&gt;&lt;div style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;div class=&quot;math-block&quot; style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;$$\text{item.token\_count} = \text{len}(\text{tokenizer.encode}(\text{item.formatted\_content}))$$&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="170" width="415.46" x="22" y="45" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-495" connectable="0" parent="vuJTIm96bQAWBJX1B6yz-510" style="group" value="" vertex="1">
          <mxGeometry height="410" width="476" x="40" y="445" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-488" parent="vuJTIm96bQAWBJX1B6yz-495" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="410" width="476" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-489" parent="vuJTIm96bQAWBJX1B6yz-495" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Priority-Based Greedy Budget Packing&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="320" x="81" y="10" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-490" parent="vuJTIm96bQAWBJX1B6yz-495" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;p style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;The system allocates tokens using a &lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;Deterministic Tier Packing Algorithm&lt;/b&gt;:&lt;/p&gt;&lt;ol start=&quot;1&quot; style=&quot;padding-inline-start: 32px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;Calculate Available Budget:&lt;/b&gt; Extracts the context quota from &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;TaskRequest.token_budget&lt;/code&gt; (for example, if the total prompt budget is 4,000 tokens, reserving 2,000 for the task prompt and 2,000 for governance context).&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;Tier-1 Mandatory Ingestion:&lt;/b&gt; Tier 1 (Repo Rules / Security Constraints) items are packed unconditionally. If Tier 1 exceeds the budget, an alert is logged, but Tier 1 is never dropped.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;Greedy Filling for Tiers 2–4:&lt;/b&gt; The remaining token allowance is filled sequentially by priority:&lt;/p&gt;&lt;div style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;div class=&quot;math-block&quot; style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;Remaining Budget = Total Limit -&amp;nbsp; sum(Tokens (Tier 1))&lt;/div&gt;&lt;/div&gt;&lt;ul style=&quot;padding-inline-start: 32px; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;Items in Tier 2 (Company Specs) are added one by one.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;Items in Tier 3/4 (External API docs / Memories) fill any leftover space.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;If an item exceeds the remaining margin, it is either safely summarized or dropped with status: &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;PRUNED_BUDGET_EXCEEDED&lt;/code&gt;.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="335" width="438" x="22" y="60" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-496" connectable="0" parent="vuJTIm96bQAWBJX1B6yz-510" style="group" value="" vertex="1">
          <mxGeometry height="240" width="476" x="40" y="930" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-491" parent="vuJTIm96bQAWBJX1B6yz-496" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="240" width="476" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-492" parent="vuJTIm96bQAWBJX1B6yz-496" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Minification, Deduplication &amp;amp; Template Compilation&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="415.46" x="33.26999999999998" y="10" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-493" parent="vuJTIm96bQAWBJX1B6yz-496" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;li&gt;&lt;p&gt;&lt;b&gt;Boilerplate Stripping:&lt;/b&gt; Collapses multiple newlines, eliminates redundant markdown headers, and strips duplicate introductory phrases.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;Structured XML Envelope:&lt;/b&gt; Wraps items into standardized XML blocks. LLMs handle structured XML delimiters (like &lt;code&gt;&amp;lt;governed_context&amp;gt;&lt;/code&gt;) with higher compliance than unstructured prose.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;Provenance Tagging:&lt;/b&gt; Prepends clear authority markers to each item so the coding agent understands which constraints are non-negotiable repository rules versus advisory documentation.&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="160" width="428.73" x="20" y="60" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-497" edge="1" parent="vuJTIm96bQAWBJX1B6yz-510" source="vuJTIm96bQAWBJX1B6yz-485" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="vuJTIm96bQAWBJX1B6yz-488">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-499" edge="1" parent="vuJTIm96bQAWBJX1B6yz-510" source="vuJTIm96bQAWBJX1B6yz-488" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="vuJTIm96bQAWBJX1B6yz-491">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-502" connectable="0" parent="vuJTIm96bQAWBJX1B6yz-510" style="group" value="" vertex="1">
          <mxGeometry height="940" width="470" x="580" y="190" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-500" parent="vuJTIm96bQAWBJX1B6yz-502" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#FFFFFF);" value="" vertex="1">
          <mxGeometry height="940" width="470" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-501" parent="vuJTIm96bQAWBJX1B6yz-502" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;import tiktoken&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;from typing import List, Tuple&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;class ContextCompiler:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; def __init__(self, model_name: str = &quot;gpt-4o&quot;, max_context_tokens: int = 1500):&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; self.tokenizer = tiktoken.encoding_for_model(model_name)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; self.max_context_tokens = max_context_tokens&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; def compile(&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; self,&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; candidates: List[ContextItem],&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; task: TaskRequest&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; ) -&amp;gt; Tuple[str, List[dict]]:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; # Sort candidates strictly by priority tier, then by timestamp (newest first)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; sorted_candidates = sorted(&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; candidates,&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; key=lambda item: (item.priority_tier, -item.timestamp.timestamp())&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; )&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; packed_items: List[ContextItem] = []&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; current_token_count = 0&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; audit_log: List[dict] = []&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; for item in sorted_candidates:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; # Format item block with metadata provenance&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; formatted_entry = f&quot;[{item.source_type.upper()} - {item.source_path}]: {item.content}\n&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; item_tokens = len(self.tokenizer.encode(formatted_entry))&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; # Check budget constraint&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if current_token_count + item_tokens &amp;lt;= self.max_context_tokens or item.priority_tier == 1:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; packed_items.append(item)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; current_token_count += item_tokens&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; else:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; audit_log.append({&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;id&quot;: item.id,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;action&quot;: &quot;DROPPED&quot;,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;reason&quot;: f&quot;TOKEN_BUDGET_EXCEEDED (Requires {item_tokens} tokens, {self.max_context_tokens - current_token_count} remaining)&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; })&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; # Build the final XML payload&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; compiled_xml = self._render_template(packed_items)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return compiled_xml, audit_log&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; def _render_template(self, items: List[ContextItem]) -&amp;gt; str:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; lines = [&quot;&amp;lt;governed_context&amp;gt;&quot;]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; for item in items:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; tier_label = &quot;MANDATORY_RULE&quot; if item.priority_tier == 1 else &quot;REFERENCE_DOC&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; lines.append(f&#39;&amp;nbsp; &amp;lt;context_node id=&quot;{item.id}&quot; type=&quot;{tier_label}&quot; source=&quot;{item.source_path}&quot;&amp;gt;&#39;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; lines.append(f&#39;&amp;nbsp; &amp;nbsp; {item.content.strip()}&#39;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; lines.append(&#39;&amp;nbsp; &amp;lt;/context_node&amp;gt;&#39;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; lines.append(&quot;&amp;lt;/governed_context&amp;gt;&quot;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return &quot;\n&quot;.join(lines)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="880" width="428.73" x="20.639999999999873" y="30" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-509" edge="1" parent="vuJTIm96bQAWBJX1B6yz-510" source="vuJTIm96bQAWBJX1B6yz-466" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="vuJTIm96bQAWBJX1B6yz-483">
