        <mxCell id="vuJTIm96bQAWBJX1B6yz-48" edge="1" parent="1" source="vuJTIm96bQAWBJX1B6yz-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="vuJTIm96bQAWBJX1B6yz-47" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-49" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;ul&gt;&lt;li style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;Context snippets are normalized into typed records with metadata (timestamp, priority tier, file glob).&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;Strict hierarchy eliminates baseline conflicts automatically:&lt;/p&gt;&lt;div style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;div class=&quot;math-block&quot; style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;Directory-Specific Rule --&amp;gt; Root Repo Rule --&amp;gt; Company Doc --&amp;gt; Agent Memory&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="170" width="590" x="880" y="30" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-50" edge="1" parent="1" source="vuJTIm96bQAWBJX1B6yz-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="vuJTIm96bQAWBJX1B6yz-49" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-53" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;li style=&quot;&quot;&gt;&lt;p&gt;&lt;b&gt;Doc Worker:&lt;/b&gt; Pulls relevant internal docs and cross-references package versions (e.g., checking if OAuth library in lockfile is v3 vs v4 in docs).&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;p&gt;&lt;b&gt;Rules Worker:&lt;/b&gt; Scans &lt;code&gt;AGENTS.md&lt;/code&gt;, &lt;code&gt;CLAUDE.md&lt;/code&gt;, or directory-level &lt;code&gt;.cursorrules&lt;/code&gt;, using glob path matching to exclude rules meant for other directories (e.g., ignoring &lt;code&gt;frontend/&lt;/code&gt; rules for a backend auth task).&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;p&gt;&lt;b&gt;Memory Worker:&lt;/b&gt; Queries vector storage for relevant episodic memory entries from previous runs.&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="150" width="565" x="905" y="-195" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-54" parent="1" style="whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="170" width="590" x="880" y="270" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-55" edge="1" parent="1" source="vuJTIm96bQAWBJX1B6yz-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="vuJTIm96bQAWBJX1B6yz-54" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vuJTIm96bQAWBJX1B6yz-56" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;ul&gt;&lt;li&gt;&lt;p&gt;If two rules in the same priority tier conflict (or memory contradicts a rule subtly), pass only the conflicting snippets to a fast, low-cost model (e.g., a fast SLM) using strict JSON structured outputs.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;The arbiter outputs a unified list of active constraints and relevant snippets.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="110" width="515" x="880" y="300" as="geometry" />
        </mxCell>
