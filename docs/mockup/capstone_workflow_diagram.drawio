        <mxCell id="vuJTIm96bQAWBJX1B6yz-515" parent="vuJTIm96bQAWBJX1B6yz-523" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Handoff Package to LLM Runtime&lt;/font&gt;" vertex="1">
